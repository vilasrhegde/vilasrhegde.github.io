{
  "name": "vilasrhegde-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i src/input.css -o dist/output.css --minify",
    "watch:css": "tailwindcss -i src/input.css -o dist/output.css --watch",
    "build:gallery": "node scripts/build-gallery.mjs",
    "compress": "node scripts/compress-images.mjs",
    "build": "npm run build:css && npm run build:gallery"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "sharp": "^0.33.0"
  }
}
